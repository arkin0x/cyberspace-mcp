{
  "id": "vertical-shaft",
  "title": "A two-level Maze Kit build joined by a stair and a shaft",
  "brief": "Verticality is loved: build a room with a stair that climbs through a ceiling hatch into a shaft on the floor above, and a side room off the shaft. Hatches that meet must be the same size and turned alike; seal every other opening; leave one door on the ground floor open as the way in.",
  "solution": {
    "placements": [
      { "piece": "maze-kit/cistern/cistern-steps/cistern-steps", "at": [0, 0, 0], "label": "stair room", "open": ["+z"] },
      { "piece": "maze-kit/forest/passages/shaft", "at": [0, 16, 0], "label": "shaft" },
      { "piece": "maze-kit/forest/rooms/room-small", "at": [-16, 16, 0], "turn": 90, "label": "side room" },
      { "piece": "maze-kit/shared/plugs/wall/plug-wall-door", "at": [0, 0, 0], "turn": 270, "label": "stair room east plug" },
      { "piece": "maze-kit/shared/plugs/ceiling/plug-ceiling-hallway", "at": [0, 16, 0], "label": "shaft top plug" },
      { "piece": "maze-kit/shared/plugs/wall/plug-wall-door", "at": [-16, 16, 0], "turn": 90, "label": "side room west plug" },
      { "piece": "maze-kit/forest/decor/lights/forest-decor-stone-lamp", "at": [-18, 8, 3], "label": "lamp" }
    ]
  },
  "assert": {
    "ok": true,
    "atLeast": { "tile": 3, "plug": 3 },
    "levels": 2,
    "noWarnings": ["decor-floating", "decor-sunk", "decor-in-wall", "decor-outside"]
  }
}
