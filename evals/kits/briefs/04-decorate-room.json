{
  "id": "decorate-room",
  "title": "Decorating a Maze Kit room with decor and props",
  "brief": "Furnish one cistern room: at least five decor objects of the cistern set standing on its floor, clear of the walls and of each other, and the room sealed except for its way in.",
  "solution": {
    "placements": [
      { "piece": "maze-kit/cistern/cistern-baths", "at": [0, 0, 0], "label": "baths", "open": ["-z"] },
      { "piece": "maze-kit/shared/plugs/wall/plug-wall-door", "at": [0, 0, 0], "turn": 180, "label": "north plug" },
      { "piece": "maze-kit/shared/plugs/wall/plug-wall-door", "at": [0, 0, 0], "turn": 90, "label": "west plug" },
      { "piece": "maze-kit/shared/plugs/wall/plug-wall-door", "at": [0, 0, 0], "turn": 270, "label": "east plug" },
      { "piece": "maze-kit/shared/plugs/ceiling/plug-ceiling-window", "at": [0, 0, 0], "label": "skylight plug" },
      { "piece": "maze-kit/cistern/decor/containers/cistern-decor-barrel", "at": [-5, -8, 5], "label": "barrel" },
      { "piece": "maze-kit/cistern/decor/containers/cistern-decor-box-1", "at": [5, -8, 5], "label": "crate" },
      { "piece": "maze-kit/cistern/decor/bones/cistern-decor-bones-skulls", "at": [-5, -8, -5], "label": "skull" },
      { "piece": "maze-kit/cistern/decor/mushrooms/cistern-decor-mushrooms-red", "at": [5, -8, -5], "label": "mushrooms" },
      { "piece": "maze-kit/cistern/decor/blocks/cistern-decor-block-1", "at": [0, -8, 6], "label": "block" }
    ]
  },
  "assert": {
    "ok": true,
    "atLeast": { "decor": 5 },
    "noWarnings": ["decor-floating", "decor-sunk", "decor-in-wall", "decor-outside", "overlap"]
  }
}
