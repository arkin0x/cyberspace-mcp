{
  "id": "dungeon-four-rooms",
  "title": "A four-room Maze Kit dungeon with a locked vault door",
  "brief": "Build a small dungeon of four rooms laid out along the cardinal directions, with a way in from outside on one side. The last room is a vault: close its doorway with the kit's standard door and put the treasure chest inside. Every other opening must be sealed so the rooms are fully enclosed. Check it with check_layout until there are no errors, look at it with render (top, cut 2 above the floor), then place it.",
  "solution": {
    "placements": [
      { "piece": "maze-kit/forest/rooms/room-small", "at": [0, 0, 0], "label": "A entrance", "open": ["-z"] },
      { "piece": "maze-kit/cistern/cistern-baths", "at": [0, 0, 16], "label": "B baths" },
      { "piece": "maze-kit/cistern/cistern-steps/cistern-steps", "at": [16, 0, 16], "turn": 180, "label": "C steps" },
      { "piece": "maze-kit/forest/rooms/room-small", "at": [16, 0, 0], "label": "D vault" },
      { "piece": "maze-kit/locks/doors/door-standard/door-standard", "at": [16, -8, 8], "label": "vault door" },
      { "piece": "maze-kit/shared/plugs/wall/plug-wall-door", "at": [0, 0, 16], "turn": 180, "label": "B north plug" },
      { "piece": "maze-kit/shared/plugs/wall/plug-wall-door", "at": [0, 0, 16], "turn": 90, "label": "B west plug" },
      { "piece": "maze-kit/shared/plugs/ceiling/plug-ceiling-window", "at": [0, 0, 16], "label": "B skylight plug" },
      { "piece": "maze-kit/shared/plugs/ceiling/plug-ceiling-hallway", "at": [16, 0, 16], "turn": 180, "label": "C stair top plug" },
      { "piece": "maze-kit/shared/plugs/wall/plug-wall-door", "at": [16, 0, 0], "label": "D back plug" },
      { "piece": "maze-kit/locks/chests/chest/chest", "at": [16, -8, 0], "label": "treasure" },
      { "piece": "maze-kit/cistern/decor/containers/cistern-decor-barrel", "at": [-4, -8, 20], "label": "barrel" }
    ]
  },
  "assert": {
    "ok": true,
    "atLeast": { "tile": 4, "door": 1, "plug": 4 },
    "noWarnings": ["decor-floating", "decor-sunk", "decor-in-wall", "decor-outside", "overlap"],
    "bagHeightAtMost": 6
  }
}
